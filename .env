# Enterprise RAG AI Assistant Environment Configuration

# Server Config
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Storage Config
DATA_DIR=./data
CHROMA_PERSIST_DIR=./data/chroma_db
SQLITE_DB_PATH=./data/chat_history.db

# RAG & Embedding Config
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=500
CHUNK_OVERLAP=100
DEFAULT_TOP_K=4
CONFIDENCE_THRESHOLD=0.35

# LLM Config
LLM_PROVIDER=fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
